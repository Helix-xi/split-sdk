# .env.test.example
# Copy this file to .env.test and fill in the values to run integration tests locally.

# Must be set to 'testnet' for integration tests to run
STELLAR_NETWORK=testnet

# A valid deployed StellarSplit contract ID on testnet.
# This contract acts as the base reference; tests will fetch its WASM hash
# and deploy a fresh contract instance for each test.
STELLAR_SPLIT_CONTRACT_ID=C...

# (Optional) A valid testnet token contract ID (e.g. USDC on testnet).
# If not provided, it falls back to STELLAR_SPLIT_CONTRACT_ID for simplicity.
STELLAR_SPLIT_TOKEN_CONTRACT_ID=C...
